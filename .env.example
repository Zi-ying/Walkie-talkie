# Copy this file to .env, then restart `yarn dev` (Vite only reads .env at startup).

# Signaling server (introduces browsers to each other; voice never goes through it).
# Leave these two empty to use the free PeerJS cloud server (shared, can rate-limit).
# For your own local server: run `yarn peer:local` in another terminal and use:
VITE_PEERJS_HOST=localhost
VITE_PEERJS_PORT=9000

# Claude API key for the AI notes. Empty = the radio works the same, without notes.
VITE_ANTHROPIC_API_KEY=
